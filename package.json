{
  "name": "kismet-react",
  "homepage": "https://kismet-ux.com",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@4.1.1",
  "type": "module",
  "scripts": {
    "// bootstrap scripts": "",
    "bootstrap": "yarn install && yarn build:packages",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "yarn lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "vite",
    "// clean scripts": "",
    "clean": "rm -rf node_modules build .env",
    "clean:cache": "rm -rf node_modules/.vite",
    "clean:generated-types": "rm -rf src/shared/types/graphql/__generated__"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.2",
    "react-tooltip": "^5.28.0"
  },
  "devDependencies": {
    "@types/eslint": "8.56.10",
    "@types/node": "20.19.24",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "prettier": "3.6.2",
    "sass": "^1.103.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vite-plugin-checker": "0.14.5",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "3.2.7"
  },
  "resolutions": {
    "fast-uri": "^3.1.5",
    "node-gyp": "^13.0.1",
    "micromatch": "^4.0.8",
    "@babel/helpers": "^7.26.10",
    "ajv@^8.0.1": "^8.18.0",
    "@ungap/structured-clone": "^1.3.1"
  }
}
